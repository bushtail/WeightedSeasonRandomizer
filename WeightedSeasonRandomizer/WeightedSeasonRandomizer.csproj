<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>WeightedSeasonRandomizer</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>2.0.1</Version>
        <OutputPath>bin/$(Configuration)/$(AssemblyName)/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="WTT-ServerCommonLib" Version="3.0.3" />
    </ItemGroup>
    <Target Name="StageMod" AfterTargets="Build">
        <PropertyGroup>
            <_BuildModDir>$(MSBuildProjectDirectory)/../Build/SPT_Runtime/user/mods/$(TargetName)</_BuildModDir>
            <_GameRoot>$(MSBuildProjectDirectory)/../../..</_GameRoot>
            <_GameModDir>$(_GameRoot)/SPT_Runtime/user/mods/$(TargetName)</_GameModDir>
        </PropertyGroup>
        <ItemGroup>
            <_ModResource Include="$(MSBuildProjectDirectory)/Resources/**/*" />
        </ItemGroup>
        <MakeDir Directories="$(_BuildModDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_BuildModDir)" />
        <Copy SourceFiles="@(_ModResource)" DestinationFiles="@(_ModResource->'$(_BuildModDir)/%(RecursiveDir)%(Filename)%(Extension)')" Condition="'@(_ModResource)' != ''" />
        <MakeDir Directories="$(_GameModDir)" Condition="Exists('$(_GameRoot)/SPT_Runtime/user/mods')" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_GameModDir)" Condition="Exists('$(_GameRoot)/SPT_Runtime/user/mods')" />
        <Copy SourceFiles="@(_ModResource)" DestinationFiles="@(_ModResource->'$(_GameModDir)/%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(_GameRoot)/SPT_Runtime/user/mods') and '@(_ModResource)' != ''" />
    </Target>
</Project>
